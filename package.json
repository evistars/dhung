{
  "name": "novatrix-inventory-delivery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Quản lý hàng tồn kho và hành trình giao hàng trên Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create novatrix-db --binding DB --update-config",
    "db:migrate:local": "wrangler d1 migrations apply novatrix-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply novatrix-db --remote",
    "db:info": "wrangler d1 info novatrix-db"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
